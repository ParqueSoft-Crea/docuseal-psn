<!DOCTYPE html>
<html>
  <head>
    <title></title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { margin: 0; padding: 0; background-color: #f3f8ee; }
      a { color: #086236; }
    </style>
  </head>
  <body dir="<%= TextUtils.rtl?(yield) ? 'rtl' : 'auto' %>" style="margin: 0; padding: 24px 12px; background-color: #f3f8ee; font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #1d1d1b; line-height: 1.5;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 600px; margin: 0 auto;">
      <tr>
        <td style="background-color: #ffffff; padding: 24px 32px; border-radius: 12px 12px 0 0; border-bottom: 4px solid #afc524; text-align: center;">
          <a href="<%= root_url %>"><img src="<%= root_url %>logo-psn.png" alt="ParqueSoft Nariño" height="44" style="height: 44px; width: auto; border: 0;"></a>
        </td>
      </tr>
      <tr>
        <td style="background-color: #ffffff; padding: 24px 32px; font-size: 16px;">
          <%= yield %>
        </td>
      </tr>
      <tr>
        <td style="background-color: #ffffff; padding: 0 32px 24px; border-radius: 0 0 12px 12px; font-size: 12px; color: #6b7280;">
          <%= render partial: 'shared/mailer_attribution' %>
          <p style="margin-top: 16px;">ParqueSoft Nariño · Pasto, Colombia · <a href="mailto:info@psnar.com" style="color: #086236;">info@psnar.com</a></p>
        </td>
      </tr>
    </table>
  </body>
</html>
